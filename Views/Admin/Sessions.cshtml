@model List<QRAttendanceSystem.Models.Session>
@{
    ViewData["Title"] = "كل الجلسات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="fas fa-chalkboard me-2 text-primary"></i>كل الجلسات</h4>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" name="search" class="form-control"
                           placeholder="بحث بعنوان الجلسة أو اسم المادة..." value="@ViewBag.Search">
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">بحث</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>العنوان</th>
                        <th>المادة</th>
                        <th>النوع</th>
                        <th>الدكتور</th>
                        <th>التاريخ</th>
                        <th>الحضور</th>
                        <th>الحالة</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model)
                    {
                        bool expired = DateTime.UtcNow > session.QrExpiresAt;
                        <tr>
                            <td class="fw-semibold">@session.Title</td>
                            <td>@session.Course?.Name</td>
                            <td><span class="badge bg-secondary">@session.Type</span></td>
                            <td>@session.CreatedBy?.FullName</td>
                            <td class="small text-muted">@session.SessionDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-primary">@session.AttendanceRecords.Count</span>
                            </td>
                            <td>
                                @if (!session.IsActive)
                                {
                                    <span class="badge bg-secondary">موقوف</span>
                                }
                                else if (expired)
                                {
                                    <span class="badge bg-warning text-dark">منتهي</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">نشط</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Session" asp-action="Details"
                                       asp-route-id="@session.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>