@model List<QRAttendanceSystem.Models.Course>
@{
    ViewData["Title"] = "إدارة المواد الدراسية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">
        <i class="fas fa-book me-2 text-primary"></i>
        إدارة المواد الدراسية
    </h4>
    <a asp-action="CreateCourse" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>إضافة مادة جديدة
    </a>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center border-0" style="background:linear-gradient(135deg,#1e3a5f,#2d6a9f); color:white;">
            <div class="card-body py-3">
                <div class="display-6 fw-bold">
                    @Model.Count
                </div>
                <div class="small opacity-75">
                    إجمالي المواد
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0" style="background:linear-gradient(135deg,#28a745,#20c997); color:white;">
            <div class="card-body py-3">
                <div class="display-6 fw-bold">
                    @Model.Count(c => c.IsActive)
                </div>
                <div class="small opacity-75">نشطة</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0" style="background:linear-gradient(135deg,#6c757d,#adb5bd); color:white;">
            <div class="card-body py-3">
                <div class="display-6 fw-bold">
                    @Model.Count(c => !c.IsActive)
                </div>
                <div class="small opacity-75">
                    معطلة
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0" style="background:linear-gradient(135deg,#6f42c1,#a45de0); color:white;">
            <div class="card-body py-3">
                <div class="display-6 fw-bold">
                    @{
                        int yearsCount = Model.Select(c => c.AcademicYear).Distinct().Count();
                    }
                    @yearsCount
                </div>
                <div class="small opacity-75">
                    سنوات دراسية
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" name="search"
                           class="form-control"
                           placeholder="بحث باسم المادة أو الكود..."
                           value="@ViewBag.Search">
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    بحث
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Courses by Year -->
@foreach (var year in new[] { 1, 2, 3, 4 })
{
    var yearCourses = Model.Where(c => c.AcademicYear == year).ToList();
    if (!yearCourses.Any()) continue;

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center" style="background:#f0f4f8;">
            <span class="fw-bold">
                <i class="fas fa-graduation-cap me-2 text-primary"></i>
                السنة @year
            </span>
            <span class="badge bg-primary">
                @yearCourses.Count مادة
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>اسم المادة</th>
                            <th>الكود</th>
                            <th>الساعات</th>
                            <th>الجلسات</th>
                            <th>الطلاب المسجلين</th>
                            <th>الحالة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in yearCourses)
                        {
                            <tr class="@(!course.IsActive ? "table-secondary" : "")">
                                <td class="fw-semibold">
                                    @course.Name
                                </td>
                                <td>
                                    <span class="badge bg-dark">
                                        @course.Code
                                    </span>
                                </td>
                                <td>
                                    @course.CreditHours
                                    <small class="text-muted">ساعة</small>
                                </td>
                                <td>
                                    <span class="badge bg-info">
                                        @(course.Sessions?.Count ?? 0)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-success">
                                        @(course.Enrollments?.Count ?? 0)
                                    </span>
                                </td>
                                <td>
                                    @if (course.IsActive)
                                    {
                                        <span class="badge bg-success">نشطة</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">معطلة</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <!-- تعديل -->
                                        <a asp-action="EditCourse"
                                               asp-route-id="@course.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="تعديل">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <!-- تفعيل/تعطيل -->
                                        <form asp-action="ToggleCourse"
                                              asp-route-id="@course.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm @(course.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                    title="@(course.IsActive ? "تعطيل" : "تفعيل")">
                                                <i class="fas @(course.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                            </button>
                                        </form>

                                        <!-- حذف -->
                                        @if (course.Sessions == null || !course.Sessions.Any())
                                        {
                                            <form asp-action="DeleteCourse"
                                                  asp-route-id="@course.Id"
                                                  method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="حذف"
                                                        onclick="return confirm('هل تريد حذف هذه المادة؟')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    disabled
                                                    title="لا يمكن الحذف — يوجد جلسات">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="card text-center py-5">
        <div class="text-muted">
            <i class="fas fa-book-open fa-4x mb-3 text-secondary"></i>
            <h5>لا توجد مواد دراسية</h5>
            <a asp-action="CreateCourse" class="btn btn-primary mt-2">
                إضافة أول مادة
            </a>
        </div>
    </div>
}