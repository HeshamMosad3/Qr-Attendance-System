@model QRAttendanceSystem.ViewModels.Admin.DashboardViewModel
@{
    ViewData["Title"] = "لوحة تحكم الأدمن";
}

<h4 class="mb-4 fw-bold">
    <i class="fas fa-tachometer-alt me-2 text-primary"></i>لوحة التحكم
</h4>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-2 col-6">
        <div class="card text-center border-0 h-100" style="background:linear-gradient(135deg,#1e3a5f,#2d6a9f); color:white;">
            <div class="card-body py-3">
                <i class="fas fa-user-graduate fa-2x mb-2 opacity-75"></i>
                <div class="display-6 fw-bold">@Model.TotalStudents</div>
                <div class="small opacity-75">طلاب</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card text-center border-0 h-100" style="background:linear-gradient(135deg,#6f42c1,#a45de0); color:white;">
            <div class="card-body py-3">
                <i class="fas fa-chalkboard-teacher fa-2x mb-2 opacity-75"></i>
                <div class="display-6 fw-bold">@Model.TotalDoctors</div>
                <div class="small opacity-75">دكاترة</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card text-center border-0 h-100" style="background:linear-gradient(135deg,#28a745,#20c997); color:white;">
            <div class="card-body py-3">
                <i class="fas fa-book fa-2x mb-2 opacity-75"></i>
                <div class="display-6 fw-bold">@Model.TotalCourses</div>
                <div class="small opacity-75">مواد</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card text-center border-0 h-100" style="background:linear-gradient(135deg,#fd7e14,#ffc107); color:white;">
            <div class="card-body py-3">
                <i class="fas fa-chalkboard fa-2x mb-2 opacity-75"></i>
                <div class="display-6 fw-bold">@Model.TotalSessions</div>
                <div class="small opacity-75">جلسات</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card text-center border-0 h-100" style="background:linear-gradient(135deg,#dc3545,#e83e8c); color:white;">
            <div class="card-body py-3">
                <i class="fas fa-calendar-check fa-2x mb-2 opacity-75"></i>
                <div class="display-6 fw-bold">@Model.TotalAttendanceRecords</div>
                <div class="small opacity-75">سجلات حضور</div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-3 mb-4">
    <!-- Bar Chart: نسبة حضور لكل مادة -->
    <div class="col-md-8">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                <i class="fas fa-chart-bar me-2"></i>نسبة الحضور لكل مادة
            </div>
            <div class="card-body">
                <div style="position:relative; height:260px;">
                    <canvas id="courseChart" role="img"
                            aria-label="مخطط شريطي يوضح نسبة الحضور لكل مادة دراسية">
                        @foreach (var s in Model.CourseStats)
                        {
                            @($"{s.CourseName}: {s.AttendanceRate}%")
                        }
                    </canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Doughnut Chart: توزيع المستخدمين -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                <i class="fas fa-chart-pie me-2"></i>توزيع المستخدمين
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="position:relative; height:200px; width:200px;">
                    <canvas id="usersChart" role="img"
                            aria-label="مخطط دائري يوضح توزيع المستخدمين بين طلاب ودكاترة">
                        طلاب: @Model.TotalStudents، دكاترة: @Model.TotalDoctors
                    </canvas>
                </div>
                <div style="display:flex; gap:16px; margin-top:12px; font-size:12px; color:var(--color-text-secondary);">
                    <span style="display:flex;align-items:center;gap:4px;">
                        <span style="width:10px;height:10px;border-radius:2px;background:#2d6a9f;display:inline-block;"></span>طلاب @Model.TotalStudents
                    </span>
                    <span style="display:flex;align-items:center;gap:4px;">
                        <span style="width:10px;height:10px;border-radius:2px;background:#6f42c1;display:inline-block;"></span>دكاترة @Model.TotalDoctors
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Course Stats Table -->
<div class="card">
    <div class="card-header fw-semibold">
        <i class="fas fa-table me-2"></i>إحصائيات تفصيلية لكل مادة
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>المادة</th>
                        <th>الجلسات</th>
                        <th>سجلات الحضور</th>
                        <th>نسبة الحضور</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stat in Model.CourseStats)
                    {
                        <tr>
                            <td class="fw-semibold">@stat.CourseName</td>
                            <td>@stat.TotalSessions</td>
                            <td>@stat.TotalAttendance</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:8px;">
                                        <div class="progress-bar @(stat.AttendanceRate >= 75 ? "bg-success" : stat.AttendanceRate >= 50 ? "bg-warning" : "bg-danger")"
                                             style="width:@stat.AttendanceRate%"></div>
                                    </div>
                                    <span class="small fw-semibold">@stat.AttendanceRate%</span>
                                </div>
                            </td>
                            <td>
                                @if (stat.AttendanceRate >= 75)
                                {
                                    <span class="badge bg-success">ممتاز</span>
                                }
                                else if (stat.AttendanceRate >= 50)
                                {
                                    <span class="badge bg-warning text-dark">متوسط</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">ضعيف</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
    <script>
        // Bar Chart - نسبة الحضور لكل مادة
        new Chart(document.getElementById('courseChart'), {
        type: 'bar',
        data: {
        labels: [@Html.Raw(string.Join(",", Model.CourseStats.Select(s => $"'{s.CourseName}'")))],
        datasets: [{
        label: 'نسبة الحضور %',
        data: [@string.Join(",", Model.CourseStats.Select(s => s.AttendanceRate))],
        backgroundColor: [@Html.Raw(string.Join(",", Model.CourseStats.Select(s =>
                            s.AttendanceRate >= 75 ? "'#28a745'" :
                            s.AttendanceRate >= 50 ? "'#ffc107'" : "'#dc3545'")))],
        borderRadius: 6,
        borderSkipped: false
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
        y: {
        beginAtZero: true,
        max: 100,
        ticks: { callback: v => v + '%' }
        },
        x: { ticks: { autoSkip: false, maxRotation: 30 } }
        }
        }
        });

        // Doughnut Chart - توزيع المستخدمين
        new Chart(document.getElementById('usersChart'), {
        type: 'doughnut',
        data: {
        labels: ['طلاب', 'دكاترة'],
        datasets: [{
        data: [@Model.TotalStudents, @Model.TotalDoctors],
        backgroundColor: ['#2d6a9f', '#6f42c1'],
        borderWidth: 0
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } }
        }
        });
    </script>
}