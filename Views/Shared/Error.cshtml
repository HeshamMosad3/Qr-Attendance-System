@{
    ViewData["Title"] = "خطأ";
    var code = Context.Response.StatusCode;
}

<div class="text-center py-5">
    @if (code == 404)
    {
        <i class="fas fa-search fa-5x text-muted mb-4"></i>
        <h2 class="text-muted">404 — الصفحة غير موجودة</h2>
        <p class="text-muted">الصفحة التي تبحث عنها غير موجودة أو تم نقلها.</p>
    }
    else if (code == 403)
    {
        <i class="fas fa-ban fa-5x text-danger mb-4"></i>
        <h2 class="text-danger">403 — غير مصرح</h2>
        <p class="text-muted">ليس لديك صلاحية للوصول إلى هذه الصفحة.</p>
    }
    else
    {
        <i class="fas fa-exclamation-triangle fa-5x text-warning mb-4"></i>
        <h2 class="text-warning">حدث خطأ غير متوقع</h2>
        <p class="text-muted">نعتذر، حدث خطأ في الخادم. يرجى المحاولة مرة أخرى.</p>
    }

    <div class="mt-4 d-flex gap-3 justify-content-center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-home me-2"></i>الرئيسية
        </a>
        <button onclick="history.back()" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-right me-2"></i>رجوع
        </button>
    </div>
</div>