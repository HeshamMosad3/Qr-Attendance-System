@model QRAttendanceSystem.ViewModels.Session.SessionDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل الجلسة";
}

<div class="row">
    <div class="col-md-5 mb-4">
        <div class="card text-center h-100">
            <div class="card-header py-3" style="background: linear-gradient(135deg, #1e3a5f, #2d6a9f); color:white;">
                <h5 class="mb-0"><i class="fas fa-qrcode me-2"></i>رمز QR للحضور</h5>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center p-4">
                @if (Model.Session.IsActive && Model.SecondsRemaining > 0)
                {
                    <div class="qr-container mb-3">
                        <img id="qrImage" src="data:image/png;base64,@Model.QrCodeBase64"
                             alt="QR Code" style="width:220px;height:220px;" />
                    </div>
                    <div class="alert alert-success py-2 w-100 text-center">
                        <i class="fas fa-clock me-1"></i>
                        متبقي: <span id="timer" class="fw-bold timer-badge">@Model.SecondsRemaining</span> ثانية
                    </div>
                    <div class="progress w-100 mb-3" style="height:6px;">
                        <div id="timerBar" class="progress-bar bg-success" style="width:100%"></div>
                    </div>
                }
                else
                {
                    <div class="py-4 text-muted">
                        <i class="fas fa-ban fa-4x mb-3 text-danger"></i>
                        <p class="fw-semibold">@(Model.Session.IsActive ? "انتهت صلاحية QR" : "الجلسة موقوفة")</p>
                    </div>
                }

                <div class="input-group mt-2 mb-3">
                    <input type="text" class="form-control form-control-sm" value="@Model.AttendUrl" id="attendUrl" readonly>
                    <button class="btn btn-outline-secondary btn-sm" onclick="copyUrl()">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>

                <div class="d-grid gap-2 w-100">
                    @if (Model.Session.IsActive)
                    {
                        <form asp-action="RefreshQr" asp-route-id="@Model.Session.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning w-100">
                                <i class="fas fa-sync-alt me-2"></i>تجديد QR
                            </button>
                        </form>
                        <form asp-action="Deactivate" asp-route-id="@Model.Session.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger w-100"
                                    onclick="return confirm('هل تريد إيقاف الجلسة؟')">
                                <i class="fas fa-stop-circle me-2"></i>إيقاف الجلسة
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-7 mb-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title fw-bold">@Model.Session.Title</h5>
                <div class="row text-center">
                    <div class="col-4">
                        <div class="p-2 rounded" style="background:#e8f4fd;">
                            <i class="fas fa-book text-primary"></i>
                            <div class="small fw-semibold mt-1">@Model.Session.Course?.Name</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded" style="background:#e8fdf4;">
                            <i class="fas fa-tag text-success"></i>
                            <div class="small fw-semibold mt-1">@Model.Session.Type</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded" style="background:#fdf4e8;">
                            <i class="fas fa-calendar text-warning"></i>
                            <div class="small fw-semibold mt-1">@Model.Session.SessionDate.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-4">
                        <div class="display-6 fw-bold text-primary" id="totalCount">@Model.AttendanceRecords.Count</div>
                        <div class="small text-muted">إجمالي الحضور</div>
                    </div>
                    <div class="col-4">
                        <div class="display-6 fw-bold text-success" id="onTimeCount">@Model.OnTimeCount</div>
                        <div class="small text-muted">في الوقت</div>
                    </div>
                    <div class="col-4">
                        <div class="display-6 fw-bold text-warning" id="lateCount">@Model.LateCount</div>
                        <div class="small text-muted">متأخر</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="fas fa-list me-2"></i>كشف الحضور</span>
                <a asp-action="ExportExcel" asp-route-id="@Model.Session.Id" class="btn btn-success btn-sm">
                    <i class="fas fa-file-excel me-1"></i>Excel
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>اسم الطالب</th>
                                <th>الوقت</th>
                                <th>الحالة</th>
                            </tr>
                        </thead>
                        <tbody id="attendanceBody">
                            @if (!Model.AttendanceRecords.Any())
                            {
                                <tr id="emptyRow">
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        <i class="fas fa-inbox fa-2x mb-2"></i><br>لا يوجد حضور بعد
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int i = 1;
                                @foreach (var record in Model.AttendanceRecords)
                                {
                                    <tr>
                                        <td>@(i++)</td>
                                        <td>@record.User?.FullName</td>
                                        <td>@record.ScannedAt.ToString("HH:mm:ss")</td>
                                        <td>
                                            @if (record.Status == QRAttendanceSystem.Models.AttendanceStatus.OnTime)
                                            {
                                                <span class="badge bg-success">في الوقت</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">متأخر</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        // ==========================================
        // 1. Timer & URL Logic
        // ==========================================
        const BASE_URL = window.location.protocol + "//" + window.location.host;
        let totalSeconds = 30; // حدد الوقت الافتراضي لتحديث الـ QR (مثلاً 30 ثانية)
        let seconds = @Model.SecondsRemaining;

        function updateTimer() {
        if (seconds <= 0) {
        document.getElementById('timer').textContent = '0';
        document.getElementById('timerBar').style.width = '0%';
        document.getElementById('timerBar').className = 'progress-bar bg-danger';
        // تم إلغاء لقطة الـ reload لكي يعمل التحديث اللحظي عبر الـ SignalR بسلاسة
        return;
        }
        seconds--;
        document.getElementById('timer').textContent = seconds;
        const pct = (seconds / totalSeconds) * 100;
        const bar = document.getElementById('timerBar');
        bar.style.width = pct + '%';
        if (pct < 30) bar.className = 'progress-bar bg-danger';
        else if (pct < 60) bar.className = 'progress-bar bg-warning';
        else bar.className = 'progress-bar bg-success';
        }

        const interval = setInterval(updateTimer, 1000);

        function copyUrl() {
        navigator.clipboard.writeText(document.getElementById('attendUrl').value);
        alert('تم نسخ الرابط!');
        }

        // ==========================================
        // 2. SignalR Real-Time Logic
        // ==========================================
        const SESSION_ID = @Model.Session.Id;

        const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/attendance")
        .withAutomaticReconnect()
        .build();

        // استقبال بيانات حضور الطلاب لايف وتحديث الجدول
        connection.on("NewAttendance", (data) => {
        document.getElementById("totalCount").textContent = data.totalCount;
        document.getElementById("onTimeCount").textContent = data.onTimeCount;
        document.getElementById("lateCount").textContent = data.lateCount;

        const tbody = document.getElementById("attendanceBody");
        const emptyRow = document.getElementById("emptyRow");
        if (emptyRow) emptyRow.remove();

        const newRow = document.createElement("tr");
        newRow.style.animation = "fadeIn .5s ease";
        newRow.innerHTML = `
        <td>${data.totalCount}</td>
        <td class="fw-semibold">${data.studentName}</td>
        <td>${data.scannedAt}</td>
        <td>
        <span class="badge ${data.status === 'OnTime' ? 'bg-success' : 'bg-warning text-dark'}">
        ${data.status === 'OnTime' ? 'في الوقت' : 'متأخر'}
        </span>
        </td>`;

        tbody.insertBefore(newRow, tbody.firstChild);
        });
        // 🔴 الكود الصحيح المتوافق مع السيرفر 🔴
        connection.on("QrRefreshed", (data) => {
        // السيرفر بيبعت object اسمه data وجواه التفاصيل
        document.getElementById("qrImage").src = "data:image/png;base64," + data.qrBase64;
        document.getElementById("attendUrl").value = data.attendUrl;

        // إعادة ضبط عداد الثواني لـ 30 ثانية عشان يدي تأثير التحديث المستمر
        seconds = 30; // لو حاببها 30 ثانية بالظبط
        document.getElementById('timerBar').className = 'progress-bar bg-success';

        console.log("تم استلام تحديث كود الـ QR بنجاح! وقت التحديث: " + data.refreshedAt);
        });

        // تشغيل الاتصال والربط برقم الجلسة الحالي
        async function startConnection() {
        try {
        await connection.start();
        console.log("SignalR ✅ متصل بنجاح");

        await connection.invoke("JoinSession", SESSION_ID.toString());
        console.log("Joined session group:", SESSION_ID);
        } catch (err) {
        console.error("SignalR connection error:", err);
        setTimeout(startConnection, 3000);
        }
        }

        startConnection();
    </script>

    <style>
        @@keyframes fadeIn {
        from {
        background-color: #d4edda;
        opacity: 0;
        }

        to {
        background-color: transparent;
        opacity: 1;
        }
        }
    </style>
}