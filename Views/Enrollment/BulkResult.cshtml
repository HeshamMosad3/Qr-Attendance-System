@{
    ViewData["Title"] = "نتيجة الاستيراد";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header fw-semibold">
                <i class="fas fa-clipboard-check me-2"></i>نتيجة الاستيراد الجماعي
            </div>
            <div class="card-body p-4 text-center">
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="p-3 rounded" style="background:#e8fdf4;">
                            <div class="display-5 fw-bold text-success">@ViewBag.Success</div>
                            <div class="small text-success fw-semibold">تم بنجاح</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded" style="background:#fdf4e8;">
                            <div class="display-5 fw-bold text-warning">@ViewBag.Failed</div>
                            <div class="small text-warning fw-semibold">فشل / مكرر</div>
                        </div>
                    </div>
                </div>

                @{
                    var errors = ViewBag.Errors as List<string> ?? new List<string>();
                }
                @if (errors.Any())
                {
                    <div class="text-start">
                        <h6 class="fw-semibold text-danger mb-2">
                            <i class="fas fa-exclamation-triangle me-2"></i>تفاصيل الأخطاء
                        </h6>
                        <ul class="list-group list-group-flush">
                            @foreach (var err in errors)
                            {
                                <li class="list-group-item list-group-item-warning small py-2">
                                    <i class="fas fa-times-circle text-danger me-2"></i>@err
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div class="mt-4 d-flex gap-3 justify-content-center">
                    <a asp-action="BulkImport" class="btn btn-outline-primary">
                        <i class="fas fa-redo me-2"></i>استيراد مرة أخرى
                    </a>
                    <a asp-action="Index" class="btn btn-primary">
                        <i class="fas fa-users me-2"></i>قائمة الطلاب
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>