@{
    int code = ViewBag.Code ?? 500;
    ViewData["Title"] = "خطأ " + code;
    string icon, title, msg, color;

    switch (code)
    {
        case 404:
            icon = "fa-search";
            title = "الصفحة غير موجودة";
            msg = "الصفحة التي تبحث عنها غير موجودة أو تم نقلها.";
            color = "#6c757d";
            break;
        case 403:
            icon = "fa-ban";
            title = "غير مصرح بالوصول";
            msg = "ليس لديك صلاحية لعرض هذه الصفحة.";
            color = "#dc3545";
            break;
        case 429:
            icon = "fa-hourglass-half";
            title = "طلبات كثيرة جداً";
            msg = "لقد تجاوزت الحد المسموح من الطلبات. يرجى الانتظار قليلاً.";
            color = "#fd7e14";
            break;
        default:
            icon = "fa-exclamation-triangle";
            title = "حدث خطأ غير متوقع";
            msg = "نعتذر، حدث خطأ في الخادم. يرجى المحاولة مرة أخرى.";
            color = "#ffc107";
            break;
    }
}

<div class="text-center py-5">
    <div style="width:120px;height:120px;background:@(color)22;
        border-radius:50%;display:flex;align-items:center;
        justify-content:center;margin:0 auto 24px;">
        <i class="fas @icon fa-3x" style="color:@color;"></i>
    </div>

    <h1 class="display-1 fw-bold"
        style="color:@color;opacity:.3;">
        @code
    </h1>
    <h3 class="fw-bold mb-3">@title</h3>
    <p class="text-muted mb-4"
       style="max-width:400px;margin:0 auto;">@msg</p>

    <div class="d-flex gap-3 justify-content-center">
        <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-primary px-4">
            <i class="fas fa-home me-2"></i>الرئيسية
        </a>
        <button onclick="history.back()"
                class="btn btn-outline-secondary px-4">
            <i class="fas fa-arrow-right me-2"></i>رجوع
        </button>
    </div>
</div>