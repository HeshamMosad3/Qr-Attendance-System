@{ Layout = null; }
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>تم الإرسال</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>
  body{background:linear-gradient(135deg,#1e3a5f,#2d6a9f);
       min-height:100vh;display:flex;align-items:center;}
  .card{border:none;border-radius:20px;
        box-shadow:0 20px 60px rgba(0,0,0,.3);text-align:center;}
</style>
</head>
<body>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="card p-5">
        <div class="mb-4">
          <div style="width:80px;height:80px;background:#e8fdf4;
                      border-radius:50%;display:flex;align-items:center;
                      justify-content:center;margin:0 auto;">
            <i class="fas fa-envelope-open-text fa-2x text-success"></i>
          </div>
        </div>
        <h5 class="fw-bold mb-3">تم إرسال الرابط!</h5>
        <p class="text-muted mb-4" style="font-size:14px;line-height:1.7;">
          إذا كان البريد مسجلاً في النظام، ستصلك رسالة تحتوي على رابط
          إعادة تعيين كلمة المرور خلال دقائق.<br>
          تفقد البريد الوارد أو مجلد الـ Spam.
        </p>
        <div class="alert alert-warning py-2 small text-start">
          <i class="fas fa-clock me-2"></i>
          الرابط صالح لمدة <strong>24 ساعة</strong> فقط
        </div>
        <a asp-action="Login"
           class="btn btn-primary mt-3"
           style="background:linear-gradient(135deg,#1e3a5f,#2d6a9f);
                  border:none;border-radius:10px;padding:.75rem;">
          <i class="fas fa-sign-in-alt me-2"></i>
          العودة لتسجيل الدخول
        </a>
      </div>
    </div>
  </div>
</div>
</body>
</html>