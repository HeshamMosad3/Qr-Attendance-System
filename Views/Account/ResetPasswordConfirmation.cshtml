@{ Layout = null; }
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>تم تغيير كلمة المرور</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>
  body{background:linear-gradient(135deg,#1e3a5f,#2d6a9f);
       min-height:100vh;display:flex;align-items:center;}
  .card{border:none;border-radius:20px;
        box-shadow:0 20px 60px rgba(0,0,0,.3);text-align:center;}
</style>
</head>
<body>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="card p-5">
        <div class="mb-4">
          <div style="width:90px;height:90px;background:#e8fdf4;
                      border-radius:50%;display:flex;align-items:center;
                      justify-content:center;margin:0 auto;">
            <i class="fas fa-check-circle fa-3x text-success"></i>
          </div>
        </div>
        <h5 class="fw-bold mb-3">تم تغيير كلمة المرور!</h5>
        <p class="text-muted mb-4" style="font-size:14px;line-height:1.7;">
          تم تعيين كلمة المرور الجديدة بنجاح.
          يمكنك الآن تسجيل الدخول باستخدام كلمة المرور الجديدة.
        </p>
        <a asp-action="Login"
           class="btn btn-success btn-lg"
           style="border-radius:10px;">
          <i class="fas fa-sign-in-alt me-2"></i>
          تسجيل الدخول الآن
        </a>
      </div>
    </div>
  </div>
</div>
</body>
</html>