@model QRAttendanceSystem.ViewModels.Account.ForgotPasswordViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>نسيت كلمة المرور</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>
  body{background:linear-gradient(135deg,#1e3a5f,#2d6a9f);
       min-height:100vh;display:flex;align-items:center;}
  .card{border:none;border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.3);}
  .card-top{background:linear-gradient(135deg,#1e3a5f,#2d6a9f);
            border-radius:20px 20px 0 0;padding:2rem;text-align:center;color:#fff;}
  .form-control{border-radius:10px;border:2px solid #e9ecef;padding:.75rem 1rem;}
  .form-control:focus{border-color:#2d6a9f;box-shadow:none;}
  .btn-primary{background:linear-gradient(135deg,#1e3a5f,#2d6a9f);
               border:none;border-radius:10px;padding:.75rem;}
  .btn-primary:hover{opacity:.9;}
</style>
</head>
<body>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="card">
        <div class="card-top">
          <i class="fas fa-lock fa-3x mb-3"></i>
          <h5 class="mb-1">نسيت كلمة المرور؟</h5>
          <p class="mb-0 opacity-75 small">
            أدخل بريدك وهنبعتلك رابط إعادة التعيين
          </p>
        </div>
        <div class="card-body p-4">
          <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger py-2 small"></div>

            <div class="mb-4">
              <label asp-for="Email" class="form-label fw-semibold"></label>
              <div class="input-group">
                <span class="input-group-text">
                  <i class="fas fa-envelope text-muted"></i>
                </span>
                <input asp-for="Email" class="form-control"
                       placeholder="example@email.com">
              </div>
              <span asp-validation-for="Email"
                    class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">
              <i class="fas fa-paper-plane me-2"></i>
              إرسال رابط إعادة التعيين
            </button>

            <div class="text-center">
              <a asp-action="Login"
                 class="text-muted small text-decoration-none">
                <i class="fas fa-arrow-right me-1"></i>
                رجوع لتسجيل الدخول
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<partial name="_ValidationScriptsPartial" />
</body>
</html>