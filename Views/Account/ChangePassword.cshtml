@model QRAttendanceSystem.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card">
            <div class="card-header py-3"
                 style="background:linear-gradient(135deg,#1e3a5f,#2d6a9f);
                color:white;">
                <h5 class="mb-0">
                    <i class="fas fa-key me-2"></i>تغيير كلمة المرور
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword"
                               class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="CurrentPassword"
                                   type="password"
                                   class="form-control"
                                   id="curPw"
                                   placeholder="كلمة المرور الحالية">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    onclick="toggle('curPw','eyeCur')">
                                <i class="fas fa-eye" id="eyeCur"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword"
                              class="text-danger small"></span>
                    </div>

                    <hr class="my-3">

                    <div class="mb-3">
                        <label asp-for="NewPassword"
                               class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="NewPassword"
                                   type="password"
                                   class="form-control"
                                   id="newPw"
                                   placeholder="كلمة المرور الجديدة"
                                   oninput="strength(this.value)">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    onclick="toggle('newPw','eyeNew')">
                                <i class="fas fa-eye" id="eyeNew"></i>
                            </button>
                        </div>
                        <div style="height:5px;background:#e9ecef;
                            border-radius:99px;margin-top:6px;overflow:hidden;">
                            <div id="sBar"
                                 style="height:100%;border-radius:99px;
                            transition:width .3s,background .3s;
                            width:0%"></div>
                        </div>
                        <span asp-validation-for="NewPassword"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword"
                               class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   id="conPw"
                                   placeholder="تأكيد كلمة المرور الجديدة">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    onclick="toggle('conPw','eyeCon')">
                                <i class="fas fa-eye" id="eyeCon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2"
                            style="background:linear-gradient(135deg,#1e3a5f,#2d6a9f);
                        border:none;border-radius:10px;">
                        <i class="fas fa-save me-2"></i>حفظ كلمة المرور الجديدة
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggle(id, iconId) {
          const i = document.getElementById(id);
          const e = document.getElementById(iconId);
          i.type = i.type === 'password' ? 'text' : 'password';
          e.className = i.type === 'text'
            ? 'fas fa-eye-slash' : 'fas fa-eye';
        }

        function strength(pw) {
          const s = [pw.length>=6, /[A-Z]/.test(pw),
                     /[0-9]/.test(pw), /[^A-Za-z0-9]/.test(pw)]
                     .filter(Boolean).length;
          const colors = ['#dc3545','#fd7e14','#ffc107','#28a745'];
          const bar = document.getElementById('sBar');
          bar.style.width = (s * 25) + '%';
          bar.style.background = colors[s - 1] ?? '#dc3545';
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}