@model QRAttendanceSystem.ViewModels.Account.ResetPasswordViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>تعيين كلمة مرور جديدة</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>
  body{background:linear-gradient(135deg,#1e3a5f,#2d6a9f);
       min-height:100vh;display:flex;align-items:center;}
  .card{border:none;border-radius:20px;
        box-shadow:0 20px 60px rgba(0,0,0,.3);}
  .card-top{background:linear-gradient(135deg,#1e3a5f,#2d6a9f);
            border-radius:20px 20px 0 0;padding:2rem;
            text-align:center;color:#fff;}
  .form-control{border-radius:10px;border:2px solid #e9ecef;
                padding:.75rem 1rem;}
  .form-control:focus{border-color:#2d6a9f;box-shadow:none;}
  .btn-primary{background:linear-gradient(135deg,#1e3a5f,#2d6a9f);
               border:none;border-radius:10px;padding:.75rem;}
  .strength-bar{height:6px;border-radius:99px;
                background:#e9ecef;margin-top:6px;overflow:hidden;}
  .strength-fill{height:100%;border-radius:99px;
                 transition:width .3s,background .3s;}
  .toggle-pw{cursor:pointer;border-radius:0 10px 10px 0;}
</style>
</head>
<body>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
      <div class="card">
        <div class="card-top">
          <i class="fas fa-key fa-3x mb-3"></i>
          <h5 class="mb-1">تعيين كلمة مرور جديدة</h5>
          <p class="mb-0 opacity-75 small">اختر كلمة مرور قوية وآمنة</p>
        </div>
        <div class="card-body p-4">
          <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Token" type="hidden" />
            <input asp-for="Email" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger py-2 small"></div>

            <div class="mb-3">
              <label asp-for="NewPassword"
                     class="form-label fw-semibold"></label>
              <div class="input-group">
                <input asp-for="NewPassword"
                       type="password"
                       class="form-control"
                       id="newPw"
                       placeholder="••••••••"
                       oninput="checkStrength(this.value)">
                <button type="button"
                        class="btn btn-outline-secondary toggle-pw"
                        onclick="togglePw('newPw','eyeNew')">
                  <i class="fas fa-eye" id="eyeNew"></i>
                </button>
              </div>
              <div class="strength-bar mt-1">
                <div class="strength-fill"
                     id="strengthBar"
                     style="width:0%"></div>
              </div>
              <small id="strengthText"
                     class="text-muted"></small>
              <span asp-validation-for="NewPassword"
                    class="text-danger small"></span>
            </div>

            <div class="mb-4">
              <label asp-for="ConfirmPassword"
                     class="form-label fw-semibold"></label>
              <div class="input-group">
                <input asp-for="ConfirmPassword"
                       type="password"
                       class="form-control"
                       id="confirmPw"
                       placeholder="••••••••">
                <button type="button"
                        class="btn btn-outline-secondary toggle-pw"
                        onclick="togglePw('confirmPw','eyeConfirm')">
                  <i class="fas fa-eye" id="eyeConfirm"></i>
                </button>
              </div>
              <span asp-validation-for="ConfirmPassword"
                    class="text-danger small"></span>
            </div>

            <!-- Password Requirements -->
            <div class="mb-4 p-3 rounded"
                 style="background:#f8f9fa;font-size:12px;">
              <p class="fw-semibold mb-2 text-muted">
                متطلبات كلمة المرور:
              </p>
              <div id="req-len"  class="req-item text-muted">
                <i class="fas fa-circle me-1" style="font-size:6px;"></i>
                6 أحرف على الأقل
              </div>
              <div id="req-upper" class="req-item text-muted">
                <i class="fas fa-circle me-1" style="font-size:6px;"></i>
                حرف كبير واحد على الأقل
              </div>
              <div id="req-num" class="req-item text-muted">
                <i class="fas fa-circle me-1" style="font-size:6px;"></i>
                رقم واحد على الأقل
              </div>
            </div>

            <button type="submit" class="btn btn-primary w-100">
              <i class="fas fa-check-circle me-2"></i>
              تعيين كلمة المرور الجديدة
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function togglePw(inputId, iconId) {
    const inp = document.getElementById(inputId);
    const ico = document.getElementById(iconId);
    const isHidden = inp.type === 'password';
    inp.type = isHidden ? 'text' : 'password';
    ico.className = isHidden ? 'fas fa-eye-slash' : 'fas fa-eye';
  }

  function checkStrength(pw) {
    const bar  = document.getElementById('strengthBar');
    const text = document.getElementById('strengthText');
    const len   = pw.length >= 6;
    const upper = /[A-Z]/.test(pw);
    const num   = /[0-9]/.test(pw);
    const spec  = /[^A-Za-z0-9]/.test(pw);

    // Requirements UI
    setReq('req-len',   len);
    setReq('req-upper', upper);
    setReq('req-num',   num);

    const score = [len, upper, num, spec, pw.length >= 10]
                    .filter(Boolean).length;
    const levels = [
      { pct:'20%', color:'#dc3545', label:'ضعيفة جداً' },
      { pct:'40%', color:'#fd7e14', label:'ضعيفة' },
      { pct:'60%', color:'#ffc107', label:'متوسطة' },
      { pct:'80%', color:'#20c997', label:'جيدة' },
      { pct:'100%',color:'#28a745', label:'قوية جداً ✓' },
    ];
    const lvl = levels[Math.max(0, score - 1)] ?? levels[0];
    bar.style.width    = lvl.pct;
    bar.style.background = lvl.color;
    text.textContent   = lvl.label;
    text.style.color   = lvl.color;
  }

  function setReq(id, ok) {
    const el = document.getElementById(id);
    el.style.color = ok ? '#28a745' : '#888';
    el.querySelector('i').className =
      ok ? 'fas fa-check-circle me-1 text-success'
         : 'fas fa-circle me-1';
    el.querySelector('i').style.fontSize =
      ok ? '12px' : '6px';
  }
</script>
<partial name="_ValidationScriptsPartial" />
</body>
</html>